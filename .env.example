# Both entry points share credentials and appointment preferences.
USER_EMAIL=""
USER_PASSWORD=""
USER_CONSULATE="Calgary"
EARLIEST_ACCEPTABLE_DATE="2026-10-05"
LATEST_ACCEPTABLE_DATE="2026-12-31"

# Paid rescheduler: select the paid group; blank retains first-Continue behavior.
PAID_IVR_ACCOUNT_NUMBER=""

# Payment tracker: blank auto-selects only one unambiguous visible dashboard group.
# Multiple groups require the exact unpaid IVR; never falls back to the paid selector.
UNPAID_IVR_ACCOUNT_NUMBER=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
FIRST_APPOINTMENT_ALERT_IN_RANGE_ONLY="NO"  # YES limits alerts to the date window/exclusions.

# Optional preferences shared by both entry points.
EXCLUSION_START_DATE_1=""
EXCLUSION_END_DATE_1=""
DATE_REQUEST_DELAY="180"
DATE_REQUEST_JITTER="30"
FAIL_RETRY_DELAY="180"
# Tracker: access blocks or 15 setup/re-establishment failures trigger cooldown.
# "No Appointments Available" is healthy, never an unpaid soft-ban signal.
SOFT_BAN_COOLDOWN="3600"
MAX_HEALTHY_SESSION_AGE="5400"
# Existing settings.py constants control setup attempts (5), polling failures
# (5 / 900 seconds of failure time), and the fresh-browser delay (60 seconds).
# Browser renewal preserves alerts; no separate unpaid retry settings are needed.

# Paid booking only; the payment tracker still sends with TEST_MODE=True.
TEST_MODE="True"
ONLY_EARLIER_THAN_CURRENT_APPOINTMENT="True"
NUM_PARTICIPANTS="1"

# Optional paid-flow Gmail notifications.
GMAIL_SENDER_NAME=""
GMAIL_EMAIL=""
GMAIL_APPLICATION_PWD=""
RECEIVER_NAME=""
RECEIVER_EMAIL=""
